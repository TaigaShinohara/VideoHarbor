{
  "manifest_version": 3,
  "name": "VideoHarbor",
  "version": "0.3.0",
  "minimum_chrome_version": "116",
  "description": "動画の直接保存と、タブ・画面・ウィンドウの録画。",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "tabCapture"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "action": {
    "default_title": "VideoHarborを開く"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
